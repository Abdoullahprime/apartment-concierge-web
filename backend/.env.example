# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY=7d

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the "service_role" key (bypasses RLS). Keep this secret — never expose client-side.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# The frontend origin allowed to call this API
FRONTEND_URL=http://localhost:3000

# ── NestJS Observe (optional) ─────────────────────────────────────────────────
# Run: npx @nestjs/observe link   to generate these automatically
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
